# PostgreSQL connection URI from Supabase Dashboard -> Connect.
# Use a development/test database for local experiments.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Ollama API running on this machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Local LLM used for the reasoning-pattern stage.
OLLAMA_REASONING_MODEL=qwen3:4b-instruct

# Optional: full path to python.exe with pymorphy3 installed.
# If omitted on Windows, the app runs `py -3`.
# PYTHON_EXECUTABLE=C:\Path\To\Python\python.exe
